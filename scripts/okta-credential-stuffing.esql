// Okta credential stuffing and account takeover detection.
//
// Fallback reference query — paste into Kibana's ES|QL rule editor if the
// AI rule creation step produces a query that doesn't fire or errors.
//
// Detects the full four-stage attack chain grouped by (actor email, source IP):
//   Stage 1 — credential stuffing: >= 3 failed logins (INVALID_CREDENTIALS)
//   Stage 2 — MFA fatigue: failed/denied MFA challenges (informational)
//   Stage 3 — access: >= 1 successful login
//   Stage 4 — post-compromise: privilege grant, group add, policy change, etc.
//
// Note: remove the ?_tstart / ?_tend line if using the Preview button in
// Kibana — those parameters are injected automatically by the rule engine
// at schedule time and are not valid in the ad-hoc preview context.
//
// MITRE: T1110.001 Password Guessing, T1078 Valid Accounts, T1098 Account Manipulation

FROM logs-okta.system-default
| STATS
    cred_failures = COUNT(*) WHERE okta.event_type == "user.session.start"
        AND okta.outcome.result == "FAILURE"
        AND okta.outcome.reason == "INVALID_CREDENTIALS",
    mfa_failures = COUNT(*) WHERE (
        okta.event_type == "user.authentication.auth_via_mfa"
        OR okta.event_type == "user.mfa.okta_verify.deny_push"
    ) AND okta.outcome.result IN ("FAILURE", "CHALLENGE", "DENY"),
    successful_signons = COUNT(*) WHERE okta.event_type == "user.session.start"
        AND okta.outcome.result == "SUCCESS",
    post_compromise_actions = COUNT(*) WHERE okta.event_type IN (
        "group.user_membership.add",
        "user.account.privilege.grant",
        "user.mfa.factor.activate",
        "policy.lifecycle.update",
        "policy.rule.update",
        "policy.lifecycle.create",
        "policy.rule.create",
        "policy.rule.delete",
        "policy.lifecycle.delete",
        "app.user_management.push_profile_success",
        "application.user_membership.add"
    ) AND okta.outcome.result == "SUCCESS"
    BY okta.actor.alternate_id, okta.client.ip
| WHERE cred_failures >= 3 AND successful_signons >= 1 AND post_compromise_actions >= 1
| SORT cred_failures DESC
| LIMIT 100
